# Supabase project URL and publishable (anon) key: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Where the FastAPI backend is running.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: the public demo account seeded by scripts/seed_demo.py. When both
# are set, the login page shows a "Try the demo" button. The password is
# public by design; .github/workflows/reset-demo.yml restores it nightly.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
